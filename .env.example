# Configuration for `docker compose` / `podman compose` at the repository root.
# Copy this file to .env and edit it. Compose reads .env automatically.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets.
#
# This file holds only what compose itself needs: which ports to publish, and
# how the services find each other. The API's own configuration — the database
# credentials, the JWT secret, the token lifetimes — is NOT repeated here.
# compose.yaml reads backend/.env.example and then backend/.env for that, so
# there is one place to change it and the host and the container cannot drift.
#
# To set a real JWT secret, edit backend/.env, not this file:
#
#   cp backend/.env.example backend/.env
#   openssl rand -base64 48        # paste into JWT_SECRET

# Host ports. Change these when something else already listens on them; nothing
# is written into an image, so no rebuild is needed.
#
# API_PORT is bound to 127.0.0.1 only. WEB_PORT is published normally, because
# a browser on another device on your network may want to reach the frontend.
API_PORT=3000
WEB_PORT=8080

# Where nginx in the `web` container forwards /api. This is a compose service
# name, and that is correct: nginx resolves it inside the compose network.
#
# The browser never uses this value. It calls same-origin /api, and nginx
# forwards. That is the whole reason nginx is in the image — one origin means
# no CORS, and the refresh cookie stays SameSite=Lax.
#API_UPSTREAM=http://api:3000

# The browser origins the API accepts credentialed (cookie-bearing) requests
# from, comma separated. Each must match the address in the browser's URL bar
# exactly — scheme, host and port. A mismatch blocks every login with a CORS
# error and no other symptom.
#
# It lives here rather than in backend/.env because it depends on WEB_PORT
# above, which is a compose concern. The default follows that port.
#WEB_ORIGIN=http://localhost:8080
