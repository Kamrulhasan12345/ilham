# Configuration for `docker compose` / `podman compose` at the repository root.
# Copy this file to .env and edit it. Compose reads .env automatically.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets.

# REQUIRED. The API refuses to start without it, and it must be at least 32
# characters. Generate one:
#
#   openssl rand -base64 48
#
JWT_SECRET=

# Host ports. Change these when something else already listens on them; nothing
# is written into an image, so no rebuild is needed.
#
# API_PORT is bound to 127.0.0.1 only. WEB_PORT is published normally, because
# a browser on another device on your network may want to reach the frontend.
API_PORT=3000
WEB_PORT=8080

# Where nginx in the `web` container forwards /api. This is a compose service
# name, and that is correct: nginx resolves it inside the compose network.
#
# The browser never uses this value. It calls same-origin /api, and nginx
# forwards. That is the whole reason nginx is in the image — one origin means
# no CORS, and the refresh cookie stays SameSite=Lax.
#API_UPSTREAM=http://api:3000

# The browser origin the API accepts credentialed (cookie-bearing) requests
# from. It must match the address in the browser's URL bar exactly — scheme,
# host and port. A mismatch here blocks every login with a CORS error and no
# other symptom.
#
# The default matches WEB_PORT above.
#WEB_ORIGIN=http://localhost:8080
