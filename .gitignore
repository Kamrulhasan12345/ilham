# ---------------------------------------------------------------------------
# Source data. ~710MB of Ifta JSON; GitHub hard-rejects files over 100MB.
# Acquired manually — see etl/README.md for the dataset URL and the filenames.
# Integrity is guaranteed by etl/sources.json (sha256), not by version control.
# ---------------------------------------------------------------------------
etl/raw/

# Intermediate CSVs produced by `extract`. Regenerated on every run.
etl/build/

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
.npm
dist/

# ---------------------------------------------------------------------------
# Local config & secrets
# ---------------------------------------------------------------------------
.env
.env.local
etl/shape.override.local.json

# ---------------------------------------------------------------------------
# Database dumps: the canonical one IS committed (see db/README.md), so that a
# plain clone is enough to get the real corpus. Anything else named like a
# dump is almost certainly a local scratch file, not the real artifact.
# ---------------------------------------------------------------------------
*.dump
*.sql.gz
!db/ilham.dump
!db/ilham.sql.gz

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.DS_Store
*.swp
.vscode/
.idea/
