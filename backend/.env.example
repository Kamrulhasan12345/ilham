# Copy this file to .env -- the defaults below already match a freshly
# bootstrapped local database, so no editing is required for local dev.
# .env is gitignored.
#
# ilham_app is the application DB role. It has SELECT-only on the corpus
# schema (enforced by GRANT/REVOKE in db/05_post_load.sql) and read-write on
# the app schema. `docker compose up -d db` (or `./db/run_container.sh
# bootstrap`) creates it with the password below automatically -- same
# disposable local-dev credential as everything else in this repo. Change it
# (here and in the DB) before this is ever reachable from outside loopback.

PGHOST=localhost
PGPORT=5432
PGDATABASE=ilham
PGUSER=ilham_app
PGPASSWORD=ilham

PORT=3000

# Signs the access tokens. The value below is a placeholder, and it is public:
# this file is committed, so treat it as known to everyone.
#
# It is here so that `compose up` runs with no setup -- compose.yaml reads this
# file directly, and then reads .env over the top of it. It cannot follow the
# project into a deployment: config.ts keeps this exact string on a reject list
# and refuses to start unless ALLOW_DEV_SECRET=1, which only compose.yaml sets.
#
# Generate your own, in .env, before this is reachable by anyone else:
#
#   openssl rand -base64 48
#
JWT_SECRET=dev-only-insecure-secret-do-not-use-in-production
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# The browser origins allowed to send credentialed requests, comma separated.
# Each must match the browser's address exactly: scheme, host and port.
#
# This value suits `npm run dev` on the host. The container needs the published
# port of the web service instead, and compose.yaml overrides it there.
WEB_ORIGIN=http://localhost:5173

# SameSite for the refresh cookie. Leave it at Lax for anything on one origin,
# which is what the dev proxy and the nginx image both give. Set None only for
# a frontend on a genuinely different site from the API -- that also means
# Secure, so both ends need real HTTPS. config.ts refuses a combination the
# browser would reject in silence.
#COOKIE_SAMESITE=Lax

# Set to 1 only when a reverse proxy in front of the API sets X-Forwarded-For
# itself. The rate limiter then trusts that header's rightmost entry instead of
# the connection address. Leave it off otherwise: the header is client-supplied,
# and trusting it with no proxy lets anyone skip the limit.
#TRUST_PROXY=1
