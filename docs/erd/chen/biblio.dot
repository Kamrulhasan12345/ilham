digraph ERD_Biblio {
    bgcolor="#0D1117";
    splines=spline;
    overlap=prism;
    sep="+8";
    esep="+4";
    K=1.1;
    graph [fontname="DejaVu Sans Mono", fontcolor="#C9D1D9"];
    node [fontname="DejaVu Sans Mono", fontsize=11];
    // Cardinality is carried by arrowheads, not 1/N labels. The arrow points at
    // the "one" side: filled = exactly one, hollow = at most one, none = many.
    // Written `Entity -> Relationship`, so the head lands on the tail (dir=back).
    // dir=none is the graph-level default -- attribute and ISA edges stay plain.
    edge [fontname="DejaVu Sans Mono", fontsize=9, color="#8B949E", fontcolor="#C9D1D9", dir=none, arrowsize=1.1];

    // Entity boxes
    node [shape=box, style="filled,bold", penwidth=1.8, fillcolor="#21262D", color="#58A6FF", fontcolor="#E6EDF3"];
    Collection; Kitab; Surah; Bab; Hadith;

    // Relationship diamonds
    node [shape=diamond, style=filled, fillcolor="#342612", color="#D29922", penwidth=1.4, fontsize=10, fontcolor="#E6EDF3"];
    Contains_CollCh [label="Contains"];
    Divides   [label="Divides"];
    Groups    [label="Groups"];
    FiledIn   [label="Filed In"];
    CollectedIn     [label="Collected In"];
    ClassifiedUnder [label="Classified Under"];

    // Attribute ellipses
    node [shape=ellipse, style="filled", fillcolor="#161B22", color="#6E7681", penwidth=1, fontsize=9, fontcolor="#8B949E"];
    collection_id [label=<<U>collection_id</U>>];
    slug;
    title_ar;
    title_en;
    kitab_id [label=<<U>kitab_id</U>>];
    kitab_num;
    k_title_en [label="title_en"];
    k_title_ar [label="title_ar"];
    surah_num [label=<<U>surah_num</U>>];
    s_title_en [label="title_en"];
    s_title_ar [label="title_ar"];
    bab_id [label=<<U>bab_id</U>>];
    bab_seq [label="seq"];
    bab_num;
    b_title_en [label="title_en"];
    b_title_ar [label="title_ar"];
    hadith_id [label=<<U>hadith_id</U>>];
    hadith_num;
    text_plain;
    text_diac;
    matn_plain;
    matn_diac;
    sanad_count;
    chain_strength [style="filled,dashed"];

    // PK attributes with distinctive colour
    edge [color="#484F58", style=dotted];
    Collection -> collection_id [color="#E3B341", style=solid, penwidth=1.4];
    Collection -> slug;
    Collection -> title_ar;
    Collection -> title_en;
    Kitab -> kitab_id [color="#E3B341", style=solid, penwidth=1.4];
    Kitab -> kitab_num;
    Kitab -> k_title_en;
    Kitab -> k_title_ar;
    Surah -> surah_num [color="#E3B341", style=solid, penwidth=1.4];
    Surah -> s_title_en;
    Surah -> s_title_ar;
    Bab -> bab_id [color="#E3B341", style=solid, penwidth=1.4];
    Bab -> bab_seq;
    Bab -> bab_num;
    Bab -> b_title_en;
    Bab -> b_title_ar;
    Hadith -> hadith_id [color="#E3B341", style=solid, penwidth=1.4];
    Hadith -> hadith_num;
    Hadith -> text_plain;
    Hadith -> text_diac;
    Hadith -> matn_plain;
    Hadith -> matn_diac;
    Hadith -> sanad_count;
    Hadith -> chain_strength;

    // Relationships (double lines for weak-entity identifying edges)
    edge [color="#8B949E", style=solid, fontsize=11, fontcolor="#C9D1D9", penwidth=1.4];
    Collection -> Contains_CollCh [dir=back, arrowtail=normal];
    Kitab      -> Contains_CollCh [color="#8B949E:#8B949E"];
    Collection -> CollectedIn [dir=back, arrowtail=normal];
    Hadith     -> CollectedIn [color="#8B949E:#8B949E"];
    Kitab -> Divides [dir=back, arrowtail=normal];
    Bab   -> Divides [color="#8B949E:#8B949E"];
    Surah -> Groups  [dir=back, arrowtail=onormal];   // babs.surah_num nullable: Tafseer only
    Bab   -> Groups;
    Kitab -> FiledIn [dir=back, arrowtail=normal];
    Hadith -> FiledIn [color="#8B949E:#8B949E"];
    Bab -> ClassifiedUnder [dir=back, arrowtail=onormal];   // hadiths.bab_id NULL = filed at kitab level
    Hadith  -> ClassifiedUnder;
}
