// INTER-LAYER — every place the app schema reaches into the corpus.
// All four crossings point one way (app -> corpus.hadiths) and are read-only:
// corpus takes no runtime writes. Entities appear as stubs (name + PK); their
// attributes live in corpus.dot and app.dot.
//
// NOTE: no cluster boxes here on purpose. sfdp does not draw them at all, and
// neato sizes them so badly on a graph this sparse that the corpus box collides
// with its own label. The layer distinction is carried by node fill/border
// colour instead — green = app, blue = corpus — which both engines honour.
digraph ERD_InterLayer {
    bgcolor="#0D1117";
    splines=spline;
    overlap=prism;
    sep="+14";
    esep="+7";
    K=1.4;
    graph [fontname="DejaVu Sans Mono", fontcolor="#C9D1D9"];
    node [fontname="DejaVu Sans Mono", fontsize=11];
    // Cardinality is carried by arrowheads, not 1/N labels. The arrow points at
    // the "one" side: filled = exactly one, hollow = at most one, none = many.
    // Written `Entity -> Relationship`, so the head lands on the tail (dir=back).
    // dir=none is the graph-level default -- attribute and ISA edges stay plain.
    edge [fontname="DejaVu Sans Mono", fontsize=9, color="#8B949E", fontcolor="#C9D1D9", dir=none, arrowsize=1.1];

    // App-layer entities (green) — the writing side
    node [shape=box, style="filled,bold", penwidth=1.8, fillcolor="#1C2A22", color="#56D364", fontcolor="#E6EDF3"];
    StudySet; Progress; ReviewSession; Note;

    node [shape=ellipse, style="filled", fillcolor="#161B22", color="#6E7681", penwidth=1, fontsize=9, fontcolor="#8B949E"];
    ss_id [label=<<U>set_id</U>>];
    prog_id [label=<<U>progress_id</U>>];
    rs_id [label=<<U>session_id</U>>];
    note_id [label=<<U>note_id</U>>];

    edge [color="#E3B341", style=solid, penwidth=1.4];
    StudySet -> ss_id;
    Progress -> prog_id;
    ReviewSession -> rs_id;
    Note -> note_id;


    // Corpus-layer entity (blue) — the read-only target of all four crossings
    node [shape=box, style="filled,bold", penwidth=1.8, fillcolor="#21262D", color="#58A6FF", fontcolor="#E6EDF3"];
    Hadith;

    node [shape=ellipse, style="filled", fillcolor="#161B22", color="#6E7681", penwidth=1, fontsize=9, fontcolor="#8B949E"];
    h_id [label=<<U>hadith_id</U>>];

    edge [color="#E3B341", style=solid, penwidth=1.4];
    Hadith -> h_id;

    // Cross-layer relationship diamonds — red per the README colour code
    node [shape=diamond, style=filled, fillcolor="#2D1617", color="#F85149", penwidth=1.4, fontsize=10, fontcolor="#E6EDF3"];
    ContainsApp [label="Contains"];
    ProgHadith  [label="Belongs To\n(Hadith)"];
    Tested      [label="Tested"];
    About       [label="About"];

    // Relationship attribute
    node [shape=ellipse, style="filled", fillcolor="#161B22", color="#6E7681", penwidth=1, fontsize=9, fontcolor="#8B949E"];
    tested_result [label="result"];

    edge [color="#F85149", fontcolor="#FF7B72", penwidth=1.5, style=solid, fontsize=11];
    StudySet -> ContainsApp;
    Hadith   -> ContainsApp;
    Progress -> ProgHadith [color="#F85149:#F85149"];
    Hadith   -> ProgHadith [dir=back, arrowtail=normal];
    ReviewSession -> Tested;
    Hadith        -> Tested;
    Note   -> About [color="#F85149:#F85149"];
    Hadith -> About [dir=back, arrowtail=normal];

    edge [color="#484F58", style=dotted, penwidth=1];
    Tested -> tested_result;
}
