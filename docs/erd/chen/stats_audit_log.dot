digraph ERD_StatsNotesAudit {
    bgcolor="#0D1117";
    splines=spline;
    overlap=prism;
    sep="+8";
    esep="+4";
    K=1.1;
    graph [fontname="DejaVu Sans Mono", fontcolor="#C9D1D9"];
    node [fontname="DejaVu Sans Mono", fontsize=11];
    // Cardinality is carried by arrowheads, not 1/N labels. The arrow points at
    // the "one" side: filled = exactly one, hollow = at most one, none = many.
    // Written `Entity -> Relationship`, so the head lands on the tail (dir=back).
    // dir=none is the graph-level default -- attribute and ISA edges stay plain.
    edge [fontname="DejaVu Sans Mono", fontsize=9, color="#8B949E", fontcolor="#C9D1D9", dir=none, arrowsize=1.1];

    // Entity boxes
    node [shape=box, style="filled,bold", penwidth=1.8, fillcolor="#21262D", color="#58A6FF", fontcolor="#E6EDF3"];
    Student; Hadith; Note; AuditLog; User; StudentStats;

    // Relationship diamonds
    node [shape=diamond, style=filled, fillcolor="#342612", color="#D29922", penwidth=1.4, fontsize=10, fontcolor="#E6EDF3"];
    HasStats    [label="Has Stats"];
    Writes      [label="Writes"];
    About       [label="About"];
    PerformedBy [label="Performed By"];

    // Attribute ellipses
    node [shape=ellipse, style="filled", fillcolor="#161B22", color="#6E7681", penwidth=1, fontsize=9, fontcolor="#8B949E"];
    student_id [label=<<U>student_id</U>>];
    hadith_id [label=<<U>hadith_id</U>>];
    stats_pk [label=<<U>student_id</U>>];
    mastered_count [style="filled,dashed"];
    review_count [style="filled,dashed"];
    stats_updated [label="updated_at"];
    note_id [label=<<U>note_id</U>>];
    body;
    note_created [label="created_at"];
    audit_id [label=<<U>audit_id</U>>];
    table_name;
    row_key;
    old_value;
    new_value;
    changed_at;
    user_id [label=<<U>user_id</U>>];

    // PK edges
    edge [color="#484F58", style=dotted];
    Student -> student_id [color="#E3B341", style=solid, penwidth=1.4];
    Hadith -> hadith_id [color="#E3B341", style=solid, penwidth=1.4];
    StudentStats -> stats_pk [color="#E3B341", style=solid, penwidth=1.4];
    StudentStats -> mastered_count;
    StudentStats -> review_count;
    StudentStats -> stats_updated;
    Note -> note_id [color="#E3B341", style=solid, penwidth=1.4];
    Note -> body;
    Note -> note_created;
    AuditLog -> audit_id [color="#E3B341", style=solid, penwidth=1.4];
    AuditLog -> table_name;
    AuditLog -> row_key;
    AuditLog -> old_value;
    AuditLog -> new_value;
    AuditLog -> changed_at;
    User -> user_id [color="#E3B341", style=solid, penwidth=1.4];

    // Relationships
    edge [color="#8B949E", style=solid, fontsize=11, fontcolor="#C9D1D9", penwidth=1.4];
    Student      -> HasStats [dir=back, arrowtail=normal];
    StudentStats -> HasStats [dir=back, arrowtail=onormal, color="#8B949E:#8B949E"];   // no row until first trigger fire
    User -> Writes [dir=back, arrowtail=normal];
    Note -> Writes [color="#8B949E:#8B949E"];
    Note   -> About [color="#8B949E:#8B949E"];
    Hadith -> About [dir=back, arrowtail=normal];
    AuditLog -> PerformedBy;
    User     -> PerformedBy [dir=back, arrowtail=onormal];    // changed_by unchecked, best-effort
}
