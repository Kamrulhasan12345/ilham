graph ilham_full_chen {
  rankdir=LR;
  bgcolor="#0D1117";
  compound=true;
  splines=spline;
  overlap=false;
  nodesep=0.4;
  ranksep=1.0;
  node [fontname="Helvetica", fontsize=11, fontcolor="#C9D1D9"];
  edge [fontname="Helvetica", fontsize=9, color="#8B949E", fontcolor="#8B949E"];

  // ==================== CORPUS CLUSTER ====================
  subgraph cluster_corpus {
    label="CORPUS  (read-only reference)";
    fontname="Helvetica-Bold"; fontsize=15; fontcolor="#58A6FF";
    style="rounded,filled"; fillcolor="#161B22"; color="#58A6FF"; penwidth=2;

    node [shape=box, style="filled,bold", penwidth=1.5, fillcolor="#21262D", color="#58A6FF", fontcolor="#C9D1D9"];
    collections; chapters; hadiths; rank_levels; hadith_translations;
    narrators; isnad_links;

    node [shape=diamond, style="filled", fillcolor="#342612", color="#D29922", penwidth=1.2, fontsize=10, fontcolor="#C9D1D9"];
    r_coll_chap [label="has"]; r_coll_had [label="in"]; r_chap_had [label="under"];
    r_nar_ih [label="rank_IH"]; r_nar_dh [label="rank_Dh"]; r_trans [label="translates"];
    r_link_had [label="of"]; r_link_nar [label="cites"];

    collections -- r_coll_chap [taillabel="1"]; r_coll_chap -- chapters [headlabel="N"];
    hadith_translations -- r_trans [taillabel="N"]; r_trans -- hadiths [headlabel="1"];
    collections -- r_coll_had  [taillabel="1"]; r_coll_had  -- hadiths  [headlabel="N"];
    chapters    -- r_chap_had  [taillabel="1"]; r_chap_had  -- hadiths  [headlabel="N"];
    narrators   -- r_nar_ih    [taillabel="N"]; r_nar_ih    -- rank_levels [headlabel="1"];
    narrators   -- r_nar_dh    [taillabel="N"]; r_nar_dh    -- rank_levels [headlabel="1"];
    isnad_links -- r_link_had  [taillabel="N"]; r_link_had  -- hadiths   [headlabel="1"];
    isnad_links -- r_link_nar  [taillabel="N"]; r_link_nar  -- narrators [headlabel="1"];
  }

  // ==================== APP CLUSTER ====================
  subgraph cluster_app {
    label="APP  (OLTP — runtime writes)";
    fontname="Helvetica-Bold"; fontsize=15; fontcolor="#3FB950";
    style="rounded,filled"; fillcolor="#122117"; color="#3FB950"; penwidth=2;

    node [shape=box, style="filled,bold", penwidth=1.5, fillcolor="#1C2A22", color="#3FB950", fontcolor="#C9D1D9"];
    users; circles; enrollments; study_sets; set_items; assignments;
    progress; review_sessions; review_items;
    student_stats; notes; audit_log;

    node [shape=diamond, style="filled", fillcolor="#342612", color="#D29922", penwidth=1.2, fontsize=10, fontcolor="#C9D1D9"];
    r_teaches [label="teaches"]; r_enr_circ [label="into"]; r_enr_stu [label="enrolls"];
    r_set_owner [label="owns"]; r_setitem_set [label="in_set"];
    r_asg_circ [label="for_circle"]; r_asg_set [label="assigns"];
    r_prog_stu [label="tracks"]; r_prog_asg [label="under"];
    r_rs_stu [label="by"]; r_rs_rev [label="reviewed_by"]; r_rs_circ [label="in_circle"];
    r_ri_sess [label="in_session"];
    r_stats [label="summarizes"]; r_note_usr [label="wrote"];

    users -- r_teaches [taillabel="1"]; r_teaches -- circles [headlabel="N"];
    enrollments -- r_enr_circ [taillabel="N"]; r_enr_circ -- circles [headlabel="1"];
    enrollments -- r_enr_stu  [taillabel="N"]; r_enr_stu  -- users   [headlabel="1"];
    users -- r_set_owner [taillabel="1"]; r_set_owner -- study_sets [headlabel="N"];
    set_items -- r_setitem_set [taillabel="N"]; r_setitem_set -- study_sets [headlabel="1"];
    assignments -- r_asg_circ [taillabel="N"]; r_asg_circ -- circles [headlabel="1"];
    assignments -- r_asg_set  [taillabel="N"]; r_asg_set  -- study_sets [headlabel="1"];
    progress -- r_prog_stu [taillabel="N"]; r_prog_stu -- users [headlabel="1"];
    progress -- r_prog_asg [taillabel="N"]; r_prog_asg -- assignments [headlabel="0..1"];
    review_sessions -- r_rs_stu  [taillabel="N"]; r_rs_stu  -- users [headlabel="1"];
    review_sessions -- r_rs_rev  [taillabel="N"]; r_rs_rev  -- users [headlabel="1"];
    review_sessions -- r_rs_circ [taillabel="N"]; r_rs_circ -- circles [headlabel="1"];
    review_items -- r_ri_sess [taillabel="N"]; r_ri_sess -- review_sessions [headlabel="1"];
    student_stats -- r_stats [taillabel="1"]; r_stats -- users [headlabel="1"];
    notes -- r_note_usr [taillabel="N"]; r_note_usr -- users [headlabel="1"];
  }

  // ============ CROSS-LAYER relationships (app -> corpus hadiths) ============
  node [shape=diamond, style="filled", fillcolor="#2D1617", color="#F85149", penwidth=1.4, fontsize=10, fontcolor="#C9D1D9"];
  r_setitem_had [label="picks"];
  r_prog_had    [label="on_hadith"];
  r_ri_had      [label="reviewed"];
  r_note_had    [label="about"];

  set_items    -- r_setitem_had [taillabel="N", color="#F85149", fontcolor="#FF7B72"]; r_setitem_had -- hadiths [headlabel="1", color="#F85149", fontcolor="#FF7B72"];
  progress     -- r_prog_had    [taillabel="N", color="#F85149", fontcolor="#FF7B72"]; r_prog_had    -- hadiths [headlabel="1", color="#F85149", fontcolor="#FF7B72"];
  review_items -- r_ri_had      [taillabel="N", color="#F85149", fontcolor="#FF7B72"]; r_ri_had      -- hadiths [headlabel="1", color="#F85149", fontcolor="#FF7B72"];
  notes        -- r_note_had    [taillabel="N", color="#F85149", fontcolor="#FF7B72"]; r_note_had    -- hadiths [headlabel="1", color="#F85149", fontcolor="#FF7B72"];
}
