graph ilham_isnad {
  rankdir=LR;
  bgcolor="#0D1117";
  splines=spline;
  overlap=false;
  nodesep=0.55;
  ranksep=1.45;
  node [fontname="DejaVu Sans Mono", fontsize=10, fontcolor="#C9D1D9"];
  edge [fontname="DejaVu Sans Mono", fontsize=9, color="#8B949E", fontcolor="#8B949E"];

  // ---- ENTITIES ----
  node [shape=box, style="filled,bold", penwidth=1.8, fillcolor="#21262D", color="#58A6FF", fontcolor="#E6EDF3", fontsize=13];
  hadiths; narrators;

  // weak entity — double border via peripheries
  node [shape=box, peripheries=2, style="filled,bold", penwidth=1.8, fillcolor="#1F2937", color="#79C0FF", fontcolor="#E6EDF3"];
  isnad_links [label="isnad_links\n(weak: PK = hadith_id, sanad_no, position)"];

  // derived view
  node [shape=box, peripheries=1, style="filled,dashed", penwidth=1.6, fillcolor="#1B2430", color="#79C0FF", fontcolor="#79C0FF"];
  isnad_edges [label="isnad_edges  (VIEW)\nfrom_narrator → to_narrator"];

  // ---- RELATIONSHIPS ----
  node [shape=diamond, style="filled", fillcolor="#342612", color="#D29922", penwidth=1.4, fontsize=11, fontcolor="#E6EDF3"];
  r_link_had [label="of"];
  r_link_nar [label="cites"];

  node [shape=diamond, peripheries=2, style="filled", fillcolor="#3D2C08", color="#E3B341", penwidth=1.6, fontsize=11, fontcolor="#E6EDF3"];
  r_derive [label="transmits\n(derived)"];

  // ---- ATTRIBUTES on isnad_links ----
  node [shape=ellipse, style="filled", fillcolor="#161B22", color="#6E7681", penwidth=1, fontsize=9, fontcolor="#8B949E"];
  a_l1 [label="sanad_no"];
  a_l2 [label="position\n1 = Companion"];
  a_l3 [label="raw_name"];
  a_l4 [label="transmission_word\nحدثنا / أخبرني / عن"];
  a_l5 [label="is_compiler"];
  a_l6 [label="resolution\nstatus flag"];
  a_n1 [label="narrator_id"]; a_n2 [label="display_name"];
  a_n3 [label="name_norm\n(GENERATED STORED)"];
  a_n4 [label="is_placeholder\nمبهم"];

  edge [color="#484F58", style=dotted];
  isnad_links -- a_l1 [color="#E3B341", style=solid, penwidth=1.4];
  isnad_links -- a_l2 [color="#E3B341", style=solid, penwidth=1.4];
  isnad_links -- a_l3; isnad_links -- a_l4; isnad_links -- a_l5; isnad_links -- a_l6;
  narrators -- a_n1 [color="#E3B341", style=solid, penwidth=1.4];
  narrators -- a_n2; narrators -- a_n3 [style=dashed]; narrators -- a_n4;

  // ---- CARDINALITY ----
  edge [color="#8B949E", style=solid, fontsize=11, fontcolor="#C9D1D9", penwidth=1.4];
  isnad_links -- r_link_had [taillabel="N"]; r_link_had -- hadiths [headlabel="1"];
  isnad_links -- r_link_nar [taillabel="N"]; r_link_nar -- narrators [headlabel="0..1"];

  edge [color="#E3B341", fontcolor="#E3B341", style=dashed, penwidth=1.6];
  isnad_links -- r_derive [taillabel="N", label="self-join on\nposition = position+1"];
  r_derive -- isnad_edges [headlabel="N"];

  // ---- NOTES ----
  subgraph cluster_notes {
    label="WHY A VIEW, NOT A TABLE"; fontname="DejaVu Sans Mono Bold"; fontsize=12; fontcolor="#E3B341";
    style="rounded,filled"; fillcolor="#241B08"; color="#E3B341"; penwidth=1.5;
    node [shape=plaintext, fillcolor="none", fontcolor="#D8C08A", fontsize=10];
    n1 [label="• Edges are FULLY DETERMINED by paths → storing both invites drift.\l• A narrator's teachers are per-(hadith, sanad) facts, NOT narrator attributes:\l  a self-FK teacher_narrator_id cannot model M:N-per-chain.\l• Direction: position runs in propagation order, so\l  from = teacher (earlier), to = student (later) — matches MIS convention.\l• Global teacher/student network = GROUP BY from_narrator, to_narrator.\l• Upgrade path if hot: MATERIALIZED VIEW + REFRESH after seed.\l"];
  }

  subgraph cluster_res {
    label="OPTIONAL PARTICIPATION"; fontname="DejaVu Sans Mono"; fontsize=12; fontcolor="#F85149";
    style="rounded,filled"; fillcolor="#2D1617"; color="#F85149"; penwidth=1.5;
    node [shape=plaintext, fillcolor="none", fontcolor="#FFA198", fontsize=10];
    n2 [label="isnad_links.narrator_id is NULLABLE (0..1):\la chain slot may name someone with no profile row.\lMentions live only in staging.mentions (ETL Pass B\lis their sole consumer) and never reach corpus.\l\lThe link still exists as a positional fact —\lraw_name always carries the chain string.\l"];
  }
}
