graph ilham_isa {
  rankdir=TB;
  bgcolor="#0D1117";
  splines=spline;
  overlap=false;
  nodesep=0.55;
  ranksep=1.45;
  node [fontname="DejaVu Sans Mono", fontsize=10, fontcolor="#C9D1D9"];
  edge [fontname="DejaVu Sans Mono", fontsize=9, color="#8B949E", fontcolor="#8B949E"];

  // ---- SUPERTYPE ----
  node [shape=box, style="filled,bold", penwidth=2.4, fillcolor="#1C3326", color="#56D364", fontcolor="#E6EDF3", fontsize=15];
  users [label="users  (supertype)"];

  // ---- ISA TRIANGLE ----
  node [shape=triangle, style="filled", fillcolor="#3D2C08", color="#E3B341", penwidth=2.4, fontsize=12, fontcolor="#E6EDF3", height=0.85, width=1.3];
  isa [label="ISA"];

  // ---- SUBTYPES ----
  node [shape=box, style="filled,bold", penwidth=2, fillcolor="#1C2A22", color="#7EE787", fontcolor="#E6EDF3", fontsize=13];
  students; teachers; admins;

  // ---- SUPERTYPE ATTRIBUTES ----
  node [shape=ellipse, style="filled", fillcolor="#161B22", color="#6E7681", penwidth=1, fontsize=9, fontcolor="#8B949E"];
  a_u1 [label="user_id"]; a_u2 [label="email (UQ)"];
  a_u3 [label="password_hash\nbcrypt"]; a_u4 [label="full_name"];
  a_u5 [label="role\ndiscriminator"]; a_u6 [label="created_at"];
  a_s1 [label="student_level\nbeginner|intermediate|advanced"];
  a_t1 [label="institution"]; a_t2 [label="specialization"];
  a_a1 [label="admin_level\nsuper|content|support"];

  edge [color="#484F58", style=dotted];
  users -- a_u1 [color="#E3B341", style=solid, penwidth=1.4];
  users -- a_u2; users -- a_u3; users -- a_u4;
  users -- a_u5 [color="#F85149", style=solid, penwidth=1.4];
  users -- a_u6;
  students -- a_s1; teachers -- a_t1; teachers -- a_t2; admins -- a_a1;

  // ---- ISA EDGES ----
  edge [color="#E3B341", style=solid, penwidth=2.4, fontcolor="#E3B341", fontsize=12];
  users -- isa [label="  d  ", headlabel="", taillabel=""];
  isa -- students;
  isa -- teachers;
  isa -- admins;

  // ---- WHICH TABLES POINT WHERE ----
  subgraph cluster_fk {
    label="FK TARGETING — the point of the hierarchy";
    fontname="DejaVu Sans Mono Bold"; fontsize=13; fontcolor="#3FB950";
    style="rounded,filled"; fillcolor="#122117"; color="#3FB950"; penwidth=2;
    node [shape=plaintext, fillcolor="none", fontcolor="#7EE787", fontsize=10];
    fk [label="→ app.students  : enrollments, progress, student_stats,\l                  assignment_targets, review_sessions.student_id\l→ app.teachers  : circles.teacher_id, review_sessions.reviewer_id\l→ app.users     : study_sets.owner_id, notes.user_id,\l                  audit_log.changed_by   (polymorphic — any role)\l\lThe FK target IS the business rule:\l  a teacher cannot be enrolled; a student cannot own a circle.\l"];
  }

  // ---- CONSTRAINT NOTES ----
  subgraph cluster_note {
    label="DISJOINT + TOTAL"; fontname="DejaVu Sans Mono Bold"; fontsize=13; fontcolor="#E3B341";
    style="rounded,filled"; fillcolor="#241B08"; color="#E3B341"; penwidth=2;
    node [shape=plaintext, fillcolor="none", fontcolor="#D8C08A", fontsize=10];
    n1 [label="d = DISJOINT: a user is exactly one subtype.\lEnforced by:\l  CHECK (role IN ('student','teacher','admin'))  on users\l  CHECK (role = 'student')  on students\l  CHECK (role = 'teacher')  on teachers\l  CHECK (role = 'admin')    on admins\l\lCaveat (Postgres INHERITS):\l  PK/UNIQUE are NOT inherited across child tables, and\l  a FK to app.users will NOT see rows in child tables.\l  Hence subtype FKs target the child table directly.\l"];
  }

  {rank=same; students; teachers; admins;}
}
