graph ilham_app_study {
  rankdir=LR;
  bgcolor="#0D1117";
  splines=spline;
  overlap=false;
  nodesep=0.55;
  ranksep=1.45;
  node [fontname="DejaVu Sans Mono", fontsize=10, fontcolor="#C9D1D9"];
  edge [fontname="DejaVu Sans Mono", fontsize=9, color="#8B949E", fontcolor="#8B949E"];

  // ---- SUBTYPE ENTITIES ----
  node [shape=box, style="filled,bold", penwidth=2, fillcolor="#1C2A22", color="#7EE787", fontcolor="#E6EDF3", fontsize=13];
  teachers; students;

  // ---- APP ENTITIES ----
  node [shape=box, style="filled,bold", penwidth=1.7, fillcolor="#1C2A22", color="#3FB950", fontcolor="#E6EDF3", fontsize=12];
  circles; study_sets; assignments; review_sessions;

  // ---- WEAK / JUNCTION ENTITIES ----
  node [shape=box, peripheries=2, style="filled,bold", penwidth=1.5, fillcolor="#18261E", color="#3FB950", fontcolor="#C9D1D9", fontsize=11];
  enrollments        [label="enrollments\nPK (circle_id, student_id)"];
  set_items          [label="set_items\nPK (set_id, hadith_id)"];
  progress           [label="progress\nPK (progress_id)\nUQ (student_id, hadith_id, assignment_id)"];
  review_items       [label="review_items\nPK (session_id, hadith_id)"];

  // ---- CORPUS ANCHOR ----
  node [shape=box, style="filled,bold", penwidth=1.8, fillcolor="#21262D", color="#58A6FF", fontcolor="#E6EDF3", fontsize=13];
  hadiths [label="corpus.hadiths"];

  // ---- RELATIONSHIPS ----
  node [shape=diamond, style="filled", fillcolor="#342612", color="#D29922", penwidth=1.3, fontsize=10, fontcolor="#E6EDF3"];
  r_teaches [label="teaches"];
  r_enr_circ [label="into"]; r_enr_stu [label="enrolls"];
  r_setitem_set [label="in_set"];
  r_asg_circ [label="for_circle"]; r_asg_set [label="assigns"];
  r_prog_stu [label="tracks"]; r_prog_asg [label="under"];
  r_rs_stu [label="by"]; r_rs_rev [label="reviewed_by"]; r_rs_circ [label="in_circle"];
  r_ri_sess [label="in_session"];

  // ---- ATTRIBUTES ----
  node [shape=ellipse, style="filled", fillcolor="#161B22", color="#6E7681", penwidth=1, fontsize=9, fontcolor="#8B949E"];
  a_p1 [label="mastery 0..4"]; a_p2 [label="times_reviewed"]; a_p3 [label="last_reviewed"];
  a_a1 [label="due_date"];
  a_ri [label="result\npass|partial|fail"];

  edge [color="#484F58", style=dotted];
  progress -- a_p1; progress -- a_p2; progress -- a_p3;
  assignments -- a_a1;
  review_items -- a_ri;

  // ---- CARDINALITY (app internal) ----
  edge [color="#8B949E", style=solid, fontsize=11, fontcolor="#C9D1D9", penwidth=1.4];
  teachers -- r_teaches [taillabel="1"]; r_teaches -- circles [headlabel="N"];
  enrollments -- r_enr_circ [taillabel="N"]; r_enr_circ -- circles  [headlabel="1"];
  enrollments -- r_enr_stu  [taillabel="N"]; r_enr_stu  -- students [headlabel="1"];
  set_items -- r_setitem_set [taillabel="N"]; r_setitem_set -- study_sets [headlabel="1"];
  assignments -- r_asg_circ [taillabel="N"]; r_asg_circ -- circles [headlabel="1"];
  assignments -- r_asg_set  [taillabel="N"]; r_asg_set  -- study_sets [headlabel="1"];
  progress -- r_prog_asg [taillabel="N"]; r_prog_asg -- assignments [headlabel="0..1"];
  progress -- r_prog_stu [taillabel="N"]; r_prog_stu -- students [headlabel="1"];
  review_sessions -- r_rs_stu  [taillabel="N"]; r_rs_stu  -- students [headlabel="1"];
  review_sessions -- r_rs_rev  [taillabel="N"]; r_rs_rev  -- teachers [headlabel="0..1"];
  review_sessions -- r_rs_circ [taillabel="N"]; r_rs_circ -- circles  [headlabel="0..1"];
  review_items -- r_ri_sess [taillabel="N"]; r_ri_sess -- review_sessions [headlabel="1"];

  // ---- CROSS-LAYER ----
  node [shape=diamond, style="filled", fillcolor="#2D1617", color="#F85149", penwidth=1.4, fontsize=10, fontcolor="#E6EDF3"];
  r_setitem_had [label="picks"]; r_prog_had [label="on_hadith"]; r_ri_had [label="reviewed"];

  edge [color="#F85149", fontcolor="#FF7B72", penwidth=1.5];
  set_items    -- r_setitem_had [taillabel="N"]; r_setitem_had -- hadiths [headlabel="1"];
  progress     -- r_prog_had    [taillabel="N"]; r_prog_had    -- hadiths [headlabel="1"];
  review_items -- r_ri_had      [taillabel="N"]; r_ri_had      -- hadiths [headlabel="1"];

  // ---- PROCEDURE NOTE ----
  subgraph cluster_proc {
    label="app.assign_study_set(circle, set, due) — PROCEDURE";
    fontname="DejaVu Sans Mono Bold"; fontsize=13; fontcolor="#3FB950";
    style="rounded,filled"; fillcolor="#122117"; color="#3FB950"; penwidth=2;
    node [shape=plaintext, fillcolor="none", fontcolor="#7EE787", fontsize=10];
    p [label="Multi-table fan-out, owns its transaction:\l  1. INSERT assignments  → assignment_id\l  2. INSERT progress     ← students × set_items (CROSS JOIN)\l                           ON CONFLICT (student_id, hadith_id,\l                             assignment_id) WHERE assignment_id\l                             IS NOT NULL DO NOTHING\l  COMMIT\l\lPROCEDURE not FUNCTION precisely because functions\lcannot COMMIT in Postgres.\l\lNO exception handler: BEGIN..EXCEPTION opens a\lsubtransaction, and COMMIT inside one raises\l\"cannot commit while a subtransaction is active\".\lAn unhandled error already rolls the call back.\l\lEach CALL mints a NEW assignment — calling twice\lcreates two obligations, it does not deduplicate.\l"];
  }
}
