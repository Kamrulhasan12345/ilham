graph corpus_biblio_plain {
  rankdir=LR;
  bgcolor="#0D1117";
  splines=spline;
  overlap=false;
  nodesep=0.55;
  ranksep=1.6;
  node [fontname="DejaVu Sans Mono", fontsize=12, fontcolor="#C9D1D9"];
  edge [fontname="DejaVu Sans Mono", fontsize=11, color="#8B949E", fontcolor="#C9D1D9", penwidth=1.4];

  node [shape=box, style="filled,bold", penwidth=1.8, fillcolor="#21262D", color="#58A6FF", fontcolor="#E6EDF3"];
  collections; chapters; hadiths;

  node [shape=box, peripheries=2, style="filled,bold", penwidth=1.6, fillcolor="#1F2937", color="#79C0FF"];
  hadith_subjects; hadith_translations;

  node [shape=diamond, peripheries=1, style="filled", fillcolor="#342612", color="#D29922", penwidth=1.4, fontsize=11, fontcolor="#E6EDF3"];
  r_coll_chap [label="has"];
  r_coll_had  [label="in"];
  r_chap_had  [label="under"];
  r_subj      [label="tagged"];
  r_trans     [label="translates"];

  collections -- r_coll_chap [taillabel="1"]; r_coll_chap -- chapters [headlabel="N"];
  collections -- r_coll_had  [taillabel="1"]; r_coll_had  -- hadiths  [headlabel="N"];
  chapters    -- r_chap_had  [taillabel="1"]; r_chap_had  -- hadiths  [headlabel="0..N"];
  hadith_subjects -- r_subj  [taillabel="N"]; r_subj  -- hadiths [headlabel="1"];
  hadith_translations -- r_trans [taillabel="N"]; r_trans -- hadiths [headlabel="1"];
}
