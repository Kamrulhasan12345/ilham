graph isnad_plain {
  rankdir=LR;
  bgcolor="#0D1117";
  splines=spline;
  overlap=false;
  nodesep=0.55;
  ranksep=1.6;
  node [fontname="DejaVu Sans Mono", fontsize=12, fontcolor="#C9D1D9"];
  edge [fontname="DejaVu Sans Mono", fontsize=11, color="#8B949E", fontcolor="#C9D1D9", penwidth=1.4];

  node [shape=box, style="filled,bold", penwidth=1.8, fillcolor="#21262D", color="#58A6FF", fontcolor="#E6EDF3"];
  hadiths; narrators;

  node [shape=box, peripheries=2, style="filled,bold", penwidth=1.8, fillcolor="#1F2937", color="#79C0FF"];
  isnad_links;

  node [shape=box, peripheries=1, style="filled,dashed", penwidth=1.6, fillcolor="#1B2430", color="#79C0FF", fontcolor="#79C0FF"];
  isnad_edges;

  node [shape=diamond, style="filled", fillcolor="#342612", color="#D29922", penwidth=1.4, fontsize=11, fontcolor="#E6EDF3"];
  r_link_had [label="of"];
  r_link_nar [label="cites"];

  node [shape=diamond, peripheries=2, style="filled", fillcolor="#3D2C08", color="#E3B341", penwidth=1.5, fontsize=11, fontcolor="#E6EDF3"];
  r_derive [label="transmits"];

  isnad_links -- r_link_had [taillabel="N"]; r_link_had -- hadiths [headlabel="1"];
  isnad_links -- r_link_nar [taillabel="N"]; r_link_nar -- narrators [headlabel="0..1"];

  edge [color="#E3B341", fontcolor="#E3B341", style=dashed, penwidth=1.6];
  isnad_links -- r_derive [taillabel="N"];
  r_derive -- isnad_edges [headlabel="N"];
}
