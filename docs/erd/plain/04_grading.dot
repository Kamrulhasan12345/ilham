graph grading_plain {
  rankdir=LR;
  bgcolor="#0D1117";
  splines=spline;
  overlap=false;
  nodesep=0.55;
  ranksep=1.6;
  node [fontname="DejaVu Sans Mono", fontsize=12, fontcolor="#C9D1D9"];
  edge [fontname="DejaVu Sans Mono", fontsize=11, color="#8B949E", fontcolor="#C9D1D9", penwidth=1.4];

  node [shape=box, style="filled,bold", penwidth=1.8, fillcolor="#21262D", color="#58A6FF", fontcolor="#E6EDF3"];
  narrators; rank_levels; rank_map; hadiths;

  node [shape=box, peripheries=2, style="filled,bold", penwidth=1.8, fillcolor="#1F2937", color="#79C0FF"];
  isnad_links;

  node [shape=diamond, peripheries=1, style="filled", fillcolor="#342612", color="#D29922", penwidth=1.4, fontsize=11, fontcolor="#E6EDF3"];
  r_rankmap  [label="maps to"];
  r_nar_ih   [label="rank_IH"];
  r_nar_dh   [label="rank_Dh"];
  r_link_nar [label="cites"];
  r_link_had [label="of"];

  rank_map  -- r_rankmap [taillabel="N"]; r_rankmap -- rank_levels [headlabel="1"];
  narrators -- r_nar_ih  [taillabel="N"]; r_nar_ih  -- rank_levels [headlabel="0..1"];
  narrators -- r_nar_dh  [taillabel="N"]; r_nar_dh  -- rank_levels [headlabel="0..1"];
  isnad_links -- r_link_nar [taillabel="N"]; r_link_nar -- narrators [headlabel="0..1"];
  isnad_links -- r_link_had [taillabel="N"]; r_link_had -- hadiths [headlabel="1"];
}
