graph app_study_plain {
  rankdir=LR;
  bgcolor="#0D1117";
  splines=spline;
  overlap=false;
  nodesep=0.55;
  ranksep=1.5;
  node [fontname="DejaVu Sans Mono", fontsize=11, fontcolor="#C9D1D9"];
  edge [fontname="DejaVu Sans Mono", fontsize=10, color="#8B949E", fontcolor="#C9D1D9", penwidth=1.4];

  node [shape=box, style="filled,bold", penwidth=2, fillcolor="#1C2A22", color="#7EE787", fontcolor="#E6EDF3"];
  teachers; students;

  node [shape=box, style="filled,bold", penwidth=1.6, fillcolor="#1C2A22", color="#3FB950", fontcolor="#C9D1D9"];
  circles; study_sets; assignments; review_sessions;

  node [shape=box, peripheries=2, style="filled,bold", penwidth=1.5, fillcolor="#18261E", color="#3FB950"];
  enrollments; set_items; progress; review_items;

  node [shape=box, peripheries=1, style="filled,bold", penwidth=1.8, fillcolor="#21262D", color="#58A6FF", fontcolor="#E6EDF3"];
  hadiths;

  node [shape=diamond, style="filled", fillcolor="#342612", color="#D29922", penwidth=1.3, fontsize=10, fontcolor="#E6EDF3"];
  r_teaches [label="teaches"];
  r_enr_circ [label="into"]; r_enr_stu [label="enrolls"];
  r_setitem_set [label="in_set"];
  r_asg_circ [label="for_circle"]; r_asg_set [label="assigns"];
  r_prog_stu [label="tracks"]; r_prog_asg [label="under"];
  r_rs_stu [label="by"]; r_rs_rev [label="reviewed_by"]; r_rs_circ [label="in_circle"];
  r_ri_sess [label="in_session"];

  teachers -- r_teaches [taillabel="1"]; r_teaches -- circles [headlabel="N"];
  enrollments -- r_enr_circ [taillabel="N"]; r_enr_circ -- circles  [headlabel="1"];
  enrollments -- r_enr_stu  [taillabel="N"]; r_enr_stu  -- students [headlabel="1"];
  set_items -- r_setitem_set [taillabel="N"]; r_setitem_set -- study_sets [headlabel="1"];
  assignments -- r_asg_circ [taillabel="N"]; r_asg_circ -- circles [headlabel="1"];
  assignments -- r_asg_set  [taillabel="N"]; r_asg_set  -- study_sets [headlabel="1"];
  progress -- r_prog_stu [taillabel="N"]; r_prog_stu -- students [headlabel="1"];
  progress -- r_prog_asg [taillabel="N"]; r_prog_asg -- assignments [headlabel="0..1"];
  review_sessions -- r_rs_stu  [taillabel="N"]; r_rs_stu  -- students [headlabel="1"];
  review_sessions -- r_rs_rev  [taillabel="N"]; r_rs_rev  -- teachers [headlabel="0..1"];
  review_sessions -- r_rs_circ [taillabel="N"]; r_rs_circ -- circles  [headlabel="0..1"];
  review_items -- r_ri_sess [taillabel="N"]; r_ri_sess -- review_sessions [headlabel="1"];

  node [shape=diamond, style="filled", fillcolor="#2D1617", color="#F85149", penwidth=1.4, fontsize=10, fontcolor="#E6EDF3"];
  r_setitem_had [label="picks"]; r_prog_had [label="on_hadith"]; r_ri_had [label="reviewed"];

  edge [color="#F85149", fontcolor="#FF7B72", penwidth=1.5];
  set_items    -- r_setitem_had [taillabel="N"]; r_setitem_had -- hadiths [headlabel="1"];
  progress     -- r_prog_had    [taillabel="N"]; r_prog_had    -- hadiths [headlabel="1"];
  review_items -- r_ri_had      [taillabel="N"]; r_ri_had      -- hadiths [headlabel="1"];
}
