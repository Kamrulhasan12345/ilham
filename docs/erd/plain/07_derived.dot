graph derived_plain {
  rankdir=LR;
  bgcolor="#0D1117";
  splines=spline;
  overlap=false;
  nodesep=0.6;
  ranksep=1.6;
  node [fontname="DejaVu Sans Mono", fontsize=12, fontcolor="#C9D1D9"];
  edge [fontname="DejaVu Sans Mono", fontsize=11, color="#8B949E", fontcolor="#C9D1D9", penwidth=1.4];

  node [shape=box, style="filled,bold", penwidth=2, fillcolor="#1C3326", color="#56D364", fontcolor="#E6EDF3"];
  users;

  node [shape=box, style="filled,bold", penwidth=2, fillcolor="#1C2A22", color="#7EE787", fontcolor="#E6EDF3"];
  students;

  node [shape=box, peripheries=2, style="filled,bold", penwidth=1.6, fillcolor="#18261E", color="#3FB950", fontcolor="#C9D1D9"];
  progress;

  node [shape=box, peripheries=1, style="filled,dashed", penwidth=1.8, fillcolor="#1B2430", color="#79C0FF", fontcolor="#79C0FF"];
  student_stats; audit_log;

  node [shape=box, style="filled,bold", penwidth=1.6, fillcolor="#1C2A22", color="#3FB950", fontcolor="#C9D1D9"];
  notes;

  node [shape=box, style="filled,bold", penwidth=1.8, fillcolor="#21262D", color="#58A6FF", fontcolor="#E6EDF3"];
  hadiths;

  node [shape=diamond, style="filled", fillcolor="#342612", color="#D29922", penwidth=1.4, fontsize=11, fontcolor="#E6EDF3"];
  r_prog_stu  [label="tracks"];
  r_stats     [label="summarizes"];
  r_audit_usr [label="changed_by"];
  r_note_usr  [label="wrote"];

  progress -- r_prog_stu [taillabel="N"]; r_prog_stu -- students [headlabel="1"];
  student_stats -- r_stats [taillabel="1"]; r_stats -- students [headlabel="1"];
  audit_log -- r_audit_usr [taillabel="N"]; r_audit_usr -- users [headlabel="0..1"];
  notes -- r_note_usr [taillabel="N"]; r_note_usr -- users [headlabel="1"];

  node [shape=diamond, style="filled", fillcolor="#2D1617", color="#F85149", penwidth=1.4, fontsize=11, fontcolor="#E6EDF3"];
  r_prog_had [label="on_hadith"]; r_note_had [label="about"];

  edge [color="#F85149", fontcolor="#FF7B72", penwidth=1.5];
  progress -- r_prog_had [taillabel="N"]; r_prog_had -- hadiths [headlabel="1"];
  notes    -- r_note_had [taillabel="N"]; r_note_had -- hadiths [headlabel="1"];
}
