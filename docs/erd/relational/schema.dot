        audit_log [label=<
<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#161B22" COLOR="#56D364">
<TR><TD COLSPAN="3" BGCOLOR="#238636" ALIGN="CENTER"><FONT COLOR="#FFFFFF"><B>app.audit_log</B>  (shadow)</FONT></TD></TR>
<TR><TD PORT="audit_id" ALIGN="LEFT"><FONT COLOR="#E3B341">PK</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#E6EDF3">audit_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">bigint identity</FONT></TD></TR>
<TR><TD></TD><TD ALIGN="LEFT"><FONT COLOR="#E6EDF3">table_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">text</FONT></TD></TR>
<TR><TD></TD><TD ALIGN="LEFT"><FONT COLOR="#E6EDF3">row_key</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">text</FONT></TD></TR>
<TR><TD PORT="changed_by" ALIGN="LEFT"><FONT COLOR="#6E7681">--</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">changed_by</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6E7681">integer NULL  unchecked</FONT></TD></TR>
<TR><TD></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">old_value</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6E7681">jsonb NULL</FONT></TD></TR>
<TR><TD></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">new_value</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6E7681">jsonb NULL</FONT></TD></TR>
<TR><TD></TD><TD ALIGN="LEFT"><FONT COLOR="#E6EDF3">changed_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">timestamptz</FONT></TD></TR>
</TABLE>>];
    }

    // =========================================================================
    // REFERENTIAL CONSTRAINTS — child -> parent, crow foot on the many side
    // =========================================================================

    // ---- within corpus ----
    chapters:collection_id            -> collections:collection_id;
    hadiths:collection_id             -> collections:collection_id;
    hadiths:chapter_id                -> chapters:chapter_id           [arrowtail=crowodot];
    isnad_links:hadith_id             -> hadiths:hadith_id;
    isnad_links:narrator_id           -> narrators:narrator_id         [arrowtail=crowodot];
    narrators:rank_ibn_hajar          -> rank_levels:rank_code         [arrowtail=crowodot];
    narrators:rank_dhahabi            -> rank_levels:rank_code         [arrowtail=crowodot];
    hadith_translations:hadith_id     -> hadiths:hadith_id;

    // ---- within app ----
    circles:teacher_id                -> teachers:user_id;
    enrollments:circle_id             -> circles:circle_id;
    enrollments:student_id            -> students:user_id;
    set_items:set_id                  -> study_sets:set_id;
    assignments:circle_id             -> circles:circle_id;
    assignments:set_id                -> study_sets:set_id;
    progress:student_id               -> students:user_id;
    progress:assignment_id            -> assignments:assignment_id     [arrowtail=crowodot];
    review_sessions:student_id        -> students:user_id;
    review_sessions:reviewer_id       -> teachers:user_id              [arrowtail=crowodot];
    review_sessions:circle_id         -> circles:circle_id             [arrowtail=crowodot];
    review_items:session_id           -> review_sessions:session_id;
    student_stats:student_id          -> students:user_id              [arrowtail=tee];

    // ---- app -> corpus (the only four crossings; read-only target) ----
    edge [color="#F85149", fontcolor="#FF7B72", penwidth=1.6];
    set_items:hadith_id               -> hadiths:hadith_id;
    progress:hadith_id                -> hadiths:hadith_id;
    review_items:hadith_id            -> hadiths:hadith_id;
    notes:hadith_id                   -> hadiths:hadith_id;

    // ---- table inheritance (IS-A) — not a foreign key ----
    edge [color="#E3B341", fontcolor="#E3B341", penwidth=2, style=solid,
          arrowtail=none, arrowhead=onormal, label="INHERITS"];
    students:user_id -> users:user_id;
    teachers:user_id -> users:user_id;
    admins:user_id   -> users:user_id;

    // ---- polymorphic refs: any role, so no FK is possible (ONLY semantics) ----
    edge [color="#D29922", fontcolor="#D29922", penwidth=1.3, style=dashed,
          arrowtail=crow, arrowhead=tee, label="assert_user_exists()"];
    study_sets:owner_id -> users:user_id;
    notes:user_id       -> users:user_id;

    edge [label="unchecked", arrowtail=crowodot];
    audit_log:changed_by -> users:user_id;

    // ---- deferred FK: added by ALTER TABLE once rank_levels is seeded
    // (schema.sql §9), then dropped along with the rest of staging ----
    edge [color="#D29922", fontcolor="#D29922", penwidth=1.3, style=dashed,
          arrowtail=crow, arrowhead=tee, label="FK added post-seed", constraint=false];
    st_rank_map:rank_code -> rank_levels:rank_code;

    // ---- derived view ----
    edge [color="#79C0FF", fontcolor="#79C0FF", style=dashed, penwidth=1.3,
          arrowtail=none, arrowhead=onormal, label="self-join"];
    isnad_links -> isnad_edges;

    // ---- ETL flow: staging -> corpus. No constraint; staging is dropped.
    // constraint=false so this informational flow does not drag the staging
    // cluster into the middle of the referential layout.
    edge [color="#6E7681", fontcolor="#6E7681", style=dotted, penwidth=1.2,
          arrowtail=none, arrowhead=vee, label="ETL", constraint=false];
    st_hadiths    -> hadiths;
    st_chain_rows -> isnad_links;
    st_narrators  -> narrators;
    st_mentions   -> isnad_links  [label="ETL pass B"];
    st_rank_map   -> narrators    [label="applied once, then dropped"];

    // =========================================================================
    // LEGEND
    // =========================================================================
    subgraph cluster_legend {
        label="legend";
        fontcolor="#C9D1D9";
        style="rounded,filled";
        fillcolor="#0D1117";
        color="#8B949E";
        penwidth=1;

        legend [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#0D1117">
<TR><TD ALIGN="LEFT"><FONT COLOR="#E3B341">PK</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">primary key column</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#79C0FF">FK</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">foreign key column</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#F85149">FK</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">foreign key crossing app -&gt; corpus</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#D29922">UQ</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">unique constraint / index</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#D29922">TRG</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">polymorphic ref, trigger-enforced (no FK possible)</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#6E7681">NULL</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">nullable; unmarked columns are NOT NULL</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#8B949E">-&lt;</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">crow foot = many        tee = exactly one</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#8B949E">-o&lt;</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#8B949E">circle + crow = zero or one on the parent side</FONT></TD></TR>
</TABLE>>];
    }
}
