// ILHAM — RELATIONAL (CROW'S-FOOT) ERD
//
// Every table in the schema, in one graph, drawn the conventional way: each
// table is a box listing its columns with type and key badges, and every edge
// is a real referential constraint drawn child -> parent, landing on the exact
// column it references.
//
// This is the layered counterpart to the Chen set in ../chen/. Render with
// `dot` — the port-to-port edges need a layered engine; a force-directed one
// tangles them.
//
//   dot -Tsvg schema.dot -o schema.svg
//   dot -Tpng -Gdpi=150 schema.dot -o schema.png
//
// EDGE VOCABULARY
//   grey  solid   real FOREIGN KEY within one schema
//   red   solid   real FOREIGN KEY crossing app -> corpus (read-only target)
//   gold  solid   INHERITS (table inheritance; NOT a foreign key)
//   gold  dashed  polymorphic reference enforced by trigger, not by an FK
//   grey  dotted  ETL data flow (staging -> corpus); no constraint exists
//
//   crow foot = many side       tee = exactly one       o + tee = zero or one
//
digraph ilham_relational {
    rankdir=LR;
    bgcolor="#0D1117";
    compound=true;
    newrank=true;
    splines=spline;
    nodesep=0.45;
    ranksep=1.4;
    graph [fontname="DejaVu Sans Mono", fontcolor="#C9D1D9", fontsize=12];
    node  [fontname="DejaVu Sans Mono", shape=plaintext, fontsize=10];
    edge  [fontname="DejaVu Sans Mono", fontsize=9, color="#8B949E", fontcolor="#8B949E",
           dir=both, arrowtail=crow, arrowhead=tee, penwidth=1.3];

    // =========================================================================
    // STAGING — transient. Node streams raw JSON into these flat typed tables,
    // SQL does all semantic shaping, then DROP SCHEMA staging CASCADE.
    // No foreign keys here by design: the load must never fail on ordering.
    // =========================================================================
    subgraph cluster_staging {
        label="staging  —  transient ELT scratch space, DROPped after load";
        fontcolor="#8B949E";
        style="rounded,dashed,filled";
        fillcolor="#12161C";
        color="#6E7681";
        penwidth=1.6;

        st_hadiths [label=<
