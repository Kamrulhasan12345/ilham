    // =========================================================================
    // APP — the transactional study layer. Everything writable lives here.
    // =========================================================================
    subgraph cluster_app {
        label="app  —  user and study layer (OLTP; the only writable schema)";
        fontcolor="#3FB950";
        style="rounded,filled";
        fillcolor="#0E1A12";
        color="#3FB950";
        penwidth=2;

