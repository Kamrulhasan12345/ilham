    // =========================================================================
    // CORPUS — read-only reference data. Written once at seed, then the app
    // role's write privileges are REVOKEd. No trigger ever fires here.
    // =========================================================================
    subgraph cluster_corpus {
        label="corpus  —  read-only reference data (no runtime writes, ever)";
        fontcolor="#58A6FF";
        style="rounded,filled";
        fillcolor="#0F1620";
        color="#58A6FF";
        penwidth=2;

