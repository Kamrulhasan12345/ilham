# Copy to .env and adjust. Every value here is the default baked into
# src/config.js, so an empty .env works for the standard layout.

# ---------------------------------------------------------------------------
# Source data. Acquired MANUALLY — see README.md for the dataset URL.
# Drop the three files into etl/raw/ and run `npm run verify`.
# ---------------------------------------------------------------------------
ILHAM_BOOKS_DIR=./raw
ILHAM_NARRATORS_FILE=./raw/ifta_narrators.json
ILHAM_MANIFEST_FILE=./book_manifest.json

# Optional feeders. Missing paths are skipped, never fatal.
ILHAM_LK_DIR=./raw/lk-translations
ILHAM_MIS_FILE=./raw/mis_narrators.json

# ---------------------------------------------------------------------------
# Working paths
# ---------------------------------------------------------------------------
ILHAM_OUT_DIR=./build
ILHAM_SQL_DIR=./sql
ILHAM_SHAPE_OVERRIDE=./shape.override.json

# raw_doc stores the ENTIRE source record in staging.hadiths. The Ifta records
# carry takhreej/comparisons/features that no transform reads (~15KB each), so
# this defaults off. Set to 1 only when debugging source shape.
ILHAM_KEEP_RAW_DOC=0

# ---------------------------------------------------------------------------
# Database. Matches db/run_container.sh.
# ---------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=ilham
PGUSER=postgres
PGPASSWORD=ilham
