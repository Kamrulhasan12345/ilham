{
  "name": "ilham-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-token-literals.mjs && tsc -b && vite build",
