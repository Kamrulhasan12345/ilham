digraph ilham_triggers {
  rankdir=LR;
  bgcolor="#0D1117";
  splines=spline;
  nodesep=0.55;
  ranksep=1.45;
  node [fontname="DejaVu Sans Mono", fontsize=10, fontcolor="#C9D1D9"];
  edge [fontname="DejaVu Sans Mono", fontsize=9, color="#8B949E", fontcolor="#8B949E"];

  // ---- SOURCE TABLE ----
  node [shape=box, style="filled,bold", penwidth=2, fillcolor="#1C2A22", color="#3FB950", fontcolor="#E6EDF3", fontsize=13];
  progress [label="app.progress\nPK (student_id, hadith_id)\nmastery 0..4 · times_reviewed"];

  node [shape=box, style="filled,bold", penwidth=2, fillcolor="#1C2A22", color="#7EE787", fontcolor="#E6EDF3", fontsize=12];
  students [label="app.students"];
  users    [label="app.users"];

  // ---- TRIGGERS ----
  node [shape=octagon, style="filled", fillcolor="#3D2C08", color="#E3B341", penwidth=2, fontsize=11, fontcolor="#E6EDF3"];
  trg_stats [label="trg_progress_stats\nAFTER INSERT OR UPDATE\nFOR EACH ROW"];
  trg_audit [label="trg_progress_audit\nAFTER UPDATE\nFOR EACH ROW"];

  // ---- FUNCTIONS ----
  node [shape=component, style="filled", fillcolor="#241B08", color="#D29922", penwidth=1.6, fontsize=10, fontcolor="#D8C08A"];
  fn_stats [label="app.sync_student_stats()\nrecompute-and-store\nINSERT .. ON CONFLICT DO UPDATE"];
  fn_audit [label="app.audit_progress()\nfires only when\nmastery IS DISTINCT FROM"];

  // ---- DERIVED TARGETS ----
  node [shape=box, style="filled,dashed", penwidth=1.8, fillcolor="#1B2430", color="#79C0FF", fontcolor="#79C0FF", fontsize=12];
  student_stats [label="app.student_stats  (DERIVED)\nPK student_id\nmastered_count · review_count · updated_at"];
  audit_log     [label="app.audit_log  (SHADOW)\nPK audit_id\ntable_name · row_key · old_value/new_value jsonb"];

  // ---- FLOW ----
  edge [color="#3FB950", fontcolor="#7EE787", penwidth=1.6];
  progress -> trg_stats [label="row change"];
  progress -> trg_audit [label="UPDATE"];

  edge [color="#E3B341", fontcolor="#E3B341", penwidth=1.6];
  trg_stats -> fn_stats;
  trg_audit -> fn_audit;

  edge [color="#58A6FF", fontcolor="#79C0FF", penwidth=1.6];
  fn_stats -> student_stats [label="count(*) FILTER (mastery >= 3)\nsum(times_reviewed)"];
  fn_audit -> audit_log     [label="jsonb old/new\nmastery only"];

  edge [color="#8B949E", style=dashed, penwidth=1.3];
  student_stats -> students [label="1:1  PK = FK", dir=none];
  audit_log -> users [label="changed_by (nullable)\nset_config('ilham.user_id')", dir=none];
  progress -> students [label="N:1", dir=none];

  // ---- NOTES ----
  subgraph cluster_notes {
    label="WHY TRIGGERS HERE"; fontname="DejaVu Sans Mono Bold"; fontsize=12; fontcolor="#3FB950";
    style="rounded,filled"; fillcolor="#122117"; color="#3FB950"; penwidth=1.6;
    node [shape=plaintext, fillcolor="none", fontcolor="#7EE787", fontsize=10];
    n1 [label="4a  Derived value → the canonical trigger use case.\l    Recompute-and-store beats incremental deltas:\l    idempotent, self-healing after any backfill.\l\l4b  Audit → shadow table captures teacher overrides.\l    Actor arrives per-connection from the API:\l    SELECT set_config('ilham.user_id', $1, false);\l\lBoth fire INSIDE the caller's transaction — including\lthe POST /review-sessions BEGIN/COMMIT/ROLLBACK block.\l"];
  }

  // ---- NOTES entity (side) ----
  subgraph cluster_notes_tbl {
    label="ALSO IN APP LAYER"; fontname="DejaVu Sans Mono Bold"; fontsize=12; fontcolor="#58A6FF";
    style="rounded,filled"; fillcolor="#161B22"; color="#58A6FF"; penwidth=1.6;
    node [shape=plaintext, fillcolor="none", fontcolor="#8B949E", fontsize=10];
    n2 [label="app.notes — polymorphic: ANY user (student, teacher,\lor admin) may annotate ANY corpus hadith.\lFK → app.users, not a subtype. Same for study_sets.owner_id.\l"];
  }
}
